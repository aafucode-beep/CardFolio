# ==================== 数据库 ====================
DATABASE_URL=postgresql://cardfolio:CHANGE_ME@localhost:5432/cardfolio

# ==================== MinIO 对象存储 ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=cardfolio

# ==================== OCR 大模型配置 ====================
# 模型选择: minimax-m3 | glm-4v | gpt-4o | claude-3.5-sonnet
OCR_MODEL=minimax-m3
OCR_API_KEY=CHANGE_ME
OCR_API_BASE=https://api.minimax.chat/v1

# ==================== 安全配置 ====================
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== 服务配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
